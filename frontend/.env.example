# Cognito sign-in (Managed login). None of these are secret.
# The app client allows http://localhost:5173/ as its callback and sign-out URL.
VITE_COGNITO_USER_POOL_ID=us-west-2_jqXtHs6FK
VITE_COGNITO_CLIENT_ID=5daeej1uach837mtjedsi309d6
VITE_COGNITO_DOMAIN=https://timely-comp4968.auth.us-west-2.amazoncognito.com
