# Copy this file to .env.local (git-ignored) to point the portals at the deployed API.
# Leave VITE_API_BASE_URL unset to use the in-browser mocks instead (no sign-in needed).
VITE_API_BASE_URL=https://jylp5gk9vl.execute-api.us-west-2.amazonaws.com/prod

# Cognito sign-in. The app's own form talks to the user pool directly, so no hosted domain is needed.
# None of these are secret.
VITE_COGNITO_USER_POOL_ID=us-west-2_jqXtHs6FK
VITE_COGNITO_CLIENT_ID=5daeej1uach837mtjedsi309d6
